<?xml version="1.0"?>
<!-- v3 rig: new PINKLAB housing (110 mm), arm_v3 / pall_v3. Kinematics = v2.
     Tip mass: coin 6.00 g in a closed pocket (print pause). Masses (measured 2026-10-02: arm assembly 36.0 g, pall 16.0 g incl. 6.0 g discs):
     arm 36.00 g = PLA 22.45 g + 608ZZ 12.00 g + AS5600 1.55 g;
     pendulum 16.00 g = PLA 10.00 g + coin 6.00 g.
     Colours: matte black + sakura pink (#F2A7C3). Meshes in meters, pivot-aligned.
     Generated by gen_urdf_v3.py. -->
<robot name="inverted_pendulum_v3">

  <material name="matte_black"><color rgba="0.110 0.110 0.118 1"/></material>
  <material name="sakura_pink"><color rgba="0.949 0.655 0.765 1"/></material>

  <link name="base">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_v3/base_black_v3.stl"/></geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_v3/base_pink_v3.stl"/></geometry>
      <material name="sakura_pink"/>
    </visual>
  </link>

  <link name="arm">
        <inertial>
            <origin xyz="-0.00003 0.03974 0.12671" rpy="0 0 0"/>
            <mass value="0.03600"/>
            <inertia ixx="2.929e-05" iyy="3.912e-06" izz="2.893e-05"
                     ixy="-4.283e-08" ixz="-1.175e-08" iyz="2.563e-07"/>
        </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_v3/arm_v3.stl"/></geometry>
      <material name="matte_black"/>
    </visual>
  </link>

  <link name="pendulum">
        <inertial>
            <origin xyz="-0.00000 0.01165 -0.06737" rpy="0 0 0"/>
            <mass value="0.01600"/>
            <inertia ixx="2.233e-05" iyy="2.283e-05" izz="6.336e-07"
                     ixy="-3.915e-15" ixz="2.171e-14" iyz="4.065e-07"/>
        </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_v3/pendulum_v3.stl"/></geometry>
      <material name="sakura_pink"/>
    </visual>
  </link>

  <joint name="base_to_arm" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.36" upper="2.36" effort="0.14" velocity="50"/>
  </joint>

  <joint name="arm_to_pendulum" type="continuous">
    <parent link="arm"/>
    <child link="pendulum"/>
    <origin xyz="0.00000 0.06617 0.12600" rpy="0 0 0"/>
    <!-- pendulum swings TANGENTIALLY: axis = radial (along the arm, +Y). -->
    <axis xyz="0 1 0"/>
    <dynamics damping="3.160000e-05" friction="0.0"/>
  </joint>

</robot>
